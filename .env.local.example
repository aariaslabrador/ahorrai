NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para scripts/import-mercadona.mjs y scripts/import-google-places.mjs
# (importadores que corres tú a mano). NUNCA la pongas con prefijo
# NEXT_PUBLIC_ ni la uses en código de cliente: se salta la seguridad por
# fila (RLS) y da acceso total a tu base de datos.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Solo para scripts/import-google-places.mjs. Créala en console.cloud.google.com
# con la "Places API" habilitada, y restríngela a esa API.
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key
